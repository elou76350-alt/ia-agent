# Copier en .env et saisir la clé uniquement sur la machine serveur.
# Sans clé, les exercices locaux du mode découverte restent disponibles.
AGENT_API_KEY=
AGENT_MODEL=gpt-5.4
# Effort du raisonnement pour les modèles compatibles : low, medium ou high.
# Un effort élevé peut augmenter le temps de réponse et le coût du fournisseur.
AGENT_REASONING_EFFORT=high
PORT=3001
HOST=127.0.0.1
# Développement local : 0. Production publique : 1 obligatoire.
CAP_AUTH_ENABLED=0
# Code privé d'au moins 16 caractères, saisi uniquement dans l'environnement
# du serveur hôte. Sert à créer le premier compte puis peut être retiré.
# Ce secret local ne doit pas être remplacé par un jeton de proxy réseau.
CAP_SETUP_CODE=
# Dossier persistant contenant base chiffrée ET clé de chiffrement.
CAP_DATA_DIR=./data
# Origine HTTPS exacte en production, par exemple https://cap.votre-domaine.fr
APP_ORIGIN=
